---
// Cromo do jogador: o componente mais importante.
// Proporção 1:1,4. Todas as medidas derivam da largura (--wa), para funcionar de 68px a 240px.
// Medidas tiradas dos ecrãs aprovados (68, 84, 104, 116, 150 e 240px).
interface Props {
  nome: string;
  numero: number | string;
  /** Posição, equipa ou golos. */
  subtitulo?: string;
  cor: string;
  /** Largura em px (68–240). */
  largura?: number;
  /** Largura no computador (≥ 960px), se for diferente. */
  larguraComputador?: number;
  /** Só com autorização de imagem. Sem foto, mostra a silhueta. */
  foto?: string;
}

const { nome, numero, subtitulo, cor, foto } = Astro.props;
const limitar = (n: number) => Math.min(240, Math.max(68, n));
const largura = limitar(Astro.props.largura ?? 116);
const larguraPc = Astro.props.larguraComputador ? limitar(Astro.props.larguraComputador) : undefined;
const estilo = `--cor: ${cor}; --w: ${largura}px;${larguraPc ? ` --w-pc: ${larguraPc}px;` : ''}`;
---

<figure class="cromo" style={estilo}>
  <div class="interior">
    <div class="bloco" aria-hidden="true">
      {
        foto ? (
          <img src={foto} alt="" loading="lazy" decoding="async" />
        ) : (
          <svg class="silhueta" viewBox="0 0 100 100" preserveAspectRatio="xMidYMax meet">
            <circle cx="50" cy="46" r="17" />
            <path d="M14 100c0-21 16-34 36-34s36 13 36 34z" />
          </svg>
        )
      }
      <svg class="estrela" viewBox="-10 -10 20 20">
        <polygon points="0,-10 2.5,-3.4 9.5,-3.1 4,1.3 5.9,8.1 0,4.2 -5.9,8.1 -4,1.3 -9.5,-3.1 -2.5,-3.4" />
      </svg>
    </div>
    <span class="numero"><span class="visually-hidden">Número </span>{numero}</span>
    <figcaption class="texto">
      <span class="nome">{nome}</span>
      {subtitulo && <span class="sub">{subtitulo}</span>}
    </figcaption>
  </div>
</figure>

<style>
  .cromo {
    --wa: var(--w);
    /* Derivadas da largura */
    --moldura: max(4px, calc(var(--wa) * 0.042));
    --num: calc(var(--wa) * 0.267);
    --margem: max(6px, calc(var(--wa) * 0.067));
    /* Abaixo de 100px o texto não cabe nos 40% de baixo: o bloco de cor encolhe um pouco
       (até ~6px aos 68px). A partir de 100px fica nos 60% exatos. */
    --corte: max(0px, calc((100px - var(--wa)) * 0.18));

    flex: none;
    width: var(--wa);
    aspect-ratio: 1 / 1.4;
    margin: 0;
    padding: var(--moldura);
    background: var(--branco);
    border-radius: max(8px, calc(var(--wa) * 0.067));
    box-shadow: var(--sombra-cromo);
  }
  @media (min-width: 960px) {
    .cromo {
      --wa: var(--w-pc, var(--w));
    }
  }

  .interior {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: max(5px, calc(var(--wa) * 0.048));
  }
  /* Fio dourado interior, por cima do bloco de cor. */
  .interior::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1.5px var(--dourado);
    pointer-events: none;
  }

  .bloco {
    position: relative;
    flex: 0 0 calc(60% - var(--corte));
    background: var(--cor);
    overflow: hidden;
  }
  .silhueta {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: rgb(255 255 255 / 0.2);
  }
  .bloco img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .estrela {
    position: absolute;
    top: max(6px, calc(var(--wa) * 0.05));
    right: max(6px, calc(var(--wa) * 0.05));
    width: max(10px, calc(var(--wa) * 0.1));
    height: max(10px, calc(var(--wa) * 0.1));
    fill: var(--dourado);
  }

  .numero {
    position: absolute;
    left: var(--margem);
    top: calc(60% - var(--corte) - var(--num) / 2);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--num);
    height: var(--num);
    border-radius: 50%;
    background: var(--branco);
    box-shadow: 0 0 0 2px var(--cor);
    color: var(--cor);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: calc(var(--num) * 0.51);
    line-height: 1;
  }

  .texto {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: calc(var(--num) / 2 + var(--wa) * 0.03) var(--margem) 0;
  }
  .nome,
  .sub {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .nome {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: max(14px, calc(var(--wa) * 0.147));
    line-height: 1.02;
    padding-bottom: 1px; /* cedilha (Ç) não fica cortada */
    text-transform: uppercase;
    color: var(--texto);
  }
  .sub {
    margin-top: 1px;
    font-size: max(10px, calc(var(--wa) * 0.083));
    line-height: 1.2;
    color: var(--texto-2);
  }
</style>

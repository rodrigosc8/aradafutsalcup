---
// Esqueleto da fase final (/grupos#finais), a partir de torneio.quadroFinal.
// Não é clicável: os lugares só ficam definidos no fim da fase de grupos.
import { torneio } from '../data/torneio';
import { dataCurta } from '../scripts/datas';
---

<section class="finais" id="finais" aria-labelledby="titulo-finais">
  <h2 class="titulo" id="titulo-finais">Quadro das finais</h2>
  <p class="apoio">Os 2 primeiros de cada grupo seguem para os quartos-de-final.</p>
  {!torneio.quadroFinalConfirmado && <p class="proposta">Proposta de cruzamentos, a confirmar pela organização.</p>}
  <ol class="fases">
    {
      torneio.quadroFinal.map((f) => (
        <li class="fase">
          <h3>
            {f.fase}
            <span class="dia">{dataCurta(`${f.dia}T12:00:00+00:00`)}</span>
          </h3>
          <ul>
            {f.jogos.map((j) => (
              <li class="jogo">
                <span class="id">{j.id.toUpperCase()}</span>
                <span class="lado casa">{j.casa}</span>
                <span class="x" aria-hidden="true">×</span>
                <span class="visually-hidden"> contra </span>
                <span class="lado">{j.fora}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .finais {
    scroll-margin-top: 110px;
  }
  .titulo {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 32px;
    line-height: 1;
    text-transform: uppercase;
  }
  .apoio {
    margin: 6px 0 0;
    color: var(--texto-2);
  }
  .proposta {
    display: inline-block;
    margin: 12px 0 0;
    padding: 6px 12px;
    border: 1.5px dashed var(--linha);
    border-radius: var(--raio-botao);
    font-size: 13px;
    color: var(--texto-2);
  }
  .fases {
    display: grid;
    gap: 16px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  h3 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    text-transform: uppercase;
  }
  .dia {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    text-transform: none;
    color: var(--texto-2);
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jogo {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) 16px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    min-height: 52px;
    padding: 0 14px;
    border-radius: var(--raio-linha);
    background: var(--branco);
    font-size: 14px;
    font-weight: 600;
  }
  .id {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--texto-2);
  }
  .casa {
    text-align: right;
  }
  .x {
    text-align: center;
    color: var(--texto-2);
  }
  @media (min-width: 1024px) {
    .fases {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

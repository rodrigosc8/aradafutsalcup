---
// Cartão "Jogo em destaque": fundo bordô, as duas equipas, a hora, a contagem e
// "Jogadores a seguir" (2 cromos de cada equipa: os jogadores nunca representam a equipa sozinhos).
// Telemóvel e computador têm disposições diferentes (ver docs/design/).
//
// Sem `jogo` (antes do sorteio): "Jogo de abertura", emblemas neutros "?", contagem para
// torneio.inicio, .ics do torneio inteiro e "Ver o regulamento ›". Nenhum dado inventado.
import Botao from './Botao.astro';
import Cromo from './Cromo.astro';
import EmblemaEquipa from './EmblemaEquipa.astro';
import Icone from './Icone.astro';
import type { Equipa, Jogador, Jogo } from '../data/fonte';
import { torneio } from '../data/torneio';
import { dataLonga, horaLisboa, partesContagem, textoContagem, textoDia } from '../scripts/datas';
import { agora as agoraSite } from '../scripts/agora';

interface Props {
  jogo?: Jogo;
  casa?: Equipa;
  fora?: Equipa;
  /** 2 jogadores de cada equipa. */
  jogadoresCasa?: Jogador[];
  jogadoresFora?: Jogador[];
  rotulo?: string;
  /** Destino de "Ver as duas equipas". */
  hrefEquipas?: string;
}

const { jogo, casa, fora, jogadoresCasa = [], jogadoresFora = [] } = Astro.props;
const porSortear = !jogo || !casa || !fora;

const inicio = porSortear ? torneio.inicio : jogo.inicio;
const diaNum = Number(torneio.dias[0].slice(8, 10));
const rotulo = Astro.props.rotulo ?? (porSortear ? 'Jogo de abertura' : 'Jogo em destaque');
const etiqueta = porSortear ? `${diaNum} de dezembro` : jogo.grupo ? `Grupo ${jogo.grupo}` : jogo.fase;
// No lugar da hora: a hora do jogo ou, antes do sorteio, a data.
const hora = porSortear ? `${diaNum} dez` : horaLisboa(jogo.inicio);
const titulo = porSortear ? `${rotulo}, ${etiqueta}` : `${casa.nome} × ${fora.nome}`;
const nota = porSortear ? 'As equipas e os horários são conhecidos depois do sorteio.' : undefined;

// Texto do build; o script atualiza no browser.
const agora = agoraSite();
const dia = textoDia(inicio, agora);
const contagemCurta = textoContagem(inicio, 'curto', agora);
const diaLongo = dataLonga(inicio, agora);
const partes = partesContagem(inicio, agora);

const ics = porSortear
  ? {
      'data-ics': '',
      'data-ics-uid': `torneio-${torneio.dias[0].slice(0, 4)}`,
      'data-ics-dias': torneio.dias.join(','),
      'data-ics-titulo': torneio.nome,
      'data-ics-ficheiro': `abilio-pinto-futsal-cup-${torneio.dias[0].slice(0, 4)}.ics`,
    }
  : {
      'data-ics': '',
      'data-ics-uid': `${jogo.id}-${jogo.inicio.slice(0, 10)}`,
      'data-ics-inicio': jogo.inicio,
      'data-ics-titulo': `${titulo} · ${torneio.nome}`,
      'data-ics-ficheiro': `${casa.id}-${fora.id}.ics`,
    };
const acao = porSortear
  ? { texto: 'Ver o regulamento', href: torneio.links.regulamento }
  : { texto: 'Ver as duas equipas', href: Astro.props.hrefEquipas ?? `/jogos#${jogo.id}` };

type LadoCartaz = { nome?: string; sigla: string; cor?: string; jogadores: Jogador[] };
const lados: LadoCartaz[] = porSortear
  ? [
      { sigla: '?', jogadores: [] },
      { sigla: '?', jogadores: [] },
    ]
  : [
      { nome: casa.nome, sigla: casa.sigla, cor: casa.cor, jogadores: jogadoresCasa.slice(0, 2) },
      { nome: fora.nome, sigla: fora.sigla, cor: fora.cor, jogadores: jogadoresFora.slice(0, 2) },
    ];
const comJogadores = lados.some((l) => l.jogadores.length > 0);
---

<section class:list={['destaque', { 'por-sortear': porSortear }]} aria-label={`${rotulo}: ${porSortear ? etiqueta : titulo}`}>
  {/* Telemóvel */}
  <div class="movel so-telemovel">
    <p class="etiqueta centro">
      <Icone nome="estrela" tamanho={12} /><span><span data-rotulo-destaque>{rotulo}</span> · {etiqueta}</span>
    </p>
    <div class="confronto">
      {
        [lados[0], null, lados[1]].map((l) =>
          l ? (
            <div class="lado">
              <EmblemaEquipa sigla={l.sigla} cor={l.cor} neutro={!l.cor} />
              <span class:list={['nome-equipa', { vago: !l.nome }]}>{l.nome ?? 'Por sortear'}</span>
            </div>
          ) : (
            <div class="quando">
              <span class="hora">{hora}</span>
              {!porSortear && (
                <span class="dia" data-quando="dia" data-inicio={inicio}>
                  {dia}
                </span>
              )}
              <span class="contagem" data-quando="contagem" data-inicio={inicio} hidden={!contagemCurta}>
                {contagemCurta}
              </span>
            </div>
          ),
        )
      }
    </div>
    {
      comJogadores && (
        <div class="seguir">
          <p class="etiqueta">Jogadores a seguir</p>
          <div class="cromos-movel">
            {lados.flatMap((l) =>
              l.jogadores.map((j) => (
                <Cromo nome={j.nome} numero={j.numero} subtitulo={l.nome} cor={l.cor!} largura={68} />
              )),
            )}
          </div>
        </div>
      )
    }
    {nota && <p class="nota">{nota}</p>}
    <Botao variante="branco" icone="calendario" largo class="botao-cal" {...ics}>Adicionar ao calendário</Botao>
    {porSortear && <Botao variante="claro" href={acao.href} largo class="botao-sec">{acao.texto}</Botao>}
  </div>

  {/* Computador: cartaz de jogo em largura total */}
  <div class="cartaz so-computador">
    <div class="cartaz-conteudo">
      <div class="cartaz-topo">
        <p class="cartaz-rotulo"><span data-rotulo-destaque>{rotulo}</span> · {etiqueta}</p>
        <p class="cartaz-data">
          <span data-quando="dia-longo" data-inicio={inicio}>{diaLongo}</span> · {torneio.local}
        </p>
      </div>
      <div class="cartaz-grelha">
        {
          lados.map((l, i) => (
            <div class:list={['cartaz-lado', i === 0 ? 'esquerda' : 'direita']}>
              <div class="cartaz-equipa">
                <EmblemaEquipa sigla={l.sigla} cor={l.cor} neutro={!l.cor} tamanho={96} />
                <p class:list={['cartaz-nome', { vago: !l.nome }]}>{l.nome ?? 'Por sortear'}</p>
              </div>
              {l.jogadores.length > 0 && (
                <>
                  <div class="par">
                    {l.jogadores.map((j) => (
                      <Cromo nome={j.nome} numero={j.numero} subtitulo={j.posicao} cor={l.cor!} largura={132} />
                    ))}
                  </div>
                  <p class="cartaz-legenda">Jogadores a seguir</p>
                </>
              )}
            </div>
          ))
        }
        <div class="cartaz-centro">
          <p class="cartaz-hora"><span class="visually-hidden">{porSortear ? 'Começa a ' : `${titulo}, às `}</span>{hora}</p>
          <div class="contagem-partes" data-quando="partes" data-inicio={inicio}>
            <ul class="mosaicos" data-mosaicos hidden={partes.estado !== 'antes'} aria-label="Tempo até ao apito inicial">
              {
                (
                  [
                    ['dias', 'dias'],
                    ['horas', 'horas'],
                    ['minutos', 'min'],
                  ] as const
                ).map(([k, legenda]) => (
                  <li>
                    <span class="mosaico-num" data-parte={k}>
                      {partes.estado === 'antes' ? String(partes[k]).padStart(k === 'dias' ? 1 : 2, '0') : ''}
                    </span>
                    <span class="mosaico-legenda">{legenda}</span>
                  </li>
                ))
              }
            </ul>
            <p class="cartaz-sub" data-legenda>
              {partes.estado === 'antes' ? 'para o apito inicial' : partes.estado === 'decorrer' ? 'A decorrer' : 'Jogo terminado'}
            </p>
          </div>
          {nota && <p class="cartaz-nota">{nota}</p>}
          <div class="cartaz-acoes">
            <Botao variante="branco" icone="calendario" {...ics}>Adicionar ao calendário</Botao>
            <Botao variante="claro" href={acao.href}>{acao.texto}</Botao>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { atualizarQuando } from '../scripts/datas';
  import { ligarBotoesCalendario } from '../scripts/calendario';

  ligarBotoesCalendario();
  atualizarQuando();
  setInterval(() => atualizarQuando(), 30_000);
</script>

<style>
  .destaque {
    border-radius: var(--raio-cartao);
    background: var(--bordo);
    color: var(--branco);
  }
  .etiqueta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--dourado-claro);
  }
  .centro {
    justify-content: center;
    text-align: center;
  }

  /* Telemóvel */
  .movel {
    padding: 14px 16px 16px;
  }
  .confronto {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }
  .lado {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .nome-equipa {
    max-width: 100%;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    line-height: 1.05;
    text-align: center;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .quando {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hora {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 34px;
    line-height: 1;
  }
  .dia,
  .contagem {
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.3;
    color: var(--bordo-claro);
  }
  .contagem {
    margin-top: 0;
  }
  .seguir {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }
  .cromos-movel {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    justify-items: center;
    margin-top: 8px;
  }
  .movel :global(.botao-cal) {
    margin-top: 14px;
    min-height: 46px;
    font-size: 14px;
  }

  /* Antes do sorteio */
  .vago {
    color: var(--bordo-claro);
  }
  .movel .nome-equipa.vago {
    font-size: 16px;
  }
  .por-sortear .hora,
  .por-sortear .cartaz-hora {
    text-transform: uppercase;
  }
  .nota {
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.45;
    text-align: center;
    color: var(--bordo-claro);
  }
  .movel :global(.botao-sec) {
    margin-top: 10px;
    min-height: 46px;
    font-size: 14px;
  }
  .por-sortear .cartaz-nome.vago {
    font-size: 28px;
  }
  .cartaz-nota {
    max-width: 30ch;
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    text-align: center;
    color: var(--bordo-claro);
  }

  /* Computador: cartaz em largura total, por baixo da navegação flutuante */
  .cartaz {
    margin-top: -76px; /* sobe para trás da navegação sticky (16px + 60px) */
    padding: 124px 0 48px;
  }
  .cartaz-conteudo {
    max-width: calc(var(--max-largo) + 2 * var(--margem-largo));
    margin: 0 auto;
    padding-inline: var(--margem-largo);
  }
  .cartaz p {
    margin: 0;
  }
  .cartaz-topo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
  }
  .cartaz-rotulo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    text-transform: uppercase;
  }
  .cartaz-data {
    font-size: 15px;
    color: var(--bordo-claro);
  }
  .cartaz-grelha {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-areas: 'esq centro dir';
    align-items: start;
    gap: 32px;
    margin-top: 32px;
  }
  .cartaz-lado {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  .esquerda {
    grid-area: esq;
    align-items: flex-start;
  }
  .direita {
    grid-area: dir;
    align-items: flex-end;
  }
  .cartaz-equipa {
    display: flex;
    align-items: center;
    gap: 18px;
    min-width: 0;
  }
  .direita .cartaz-equipa {
    flex-direction: row-reverse;
    text-align: right;
  }
  .cartaz-nome {
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 5vw, 72px);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .par {
    display: flex;
    gap: 14px;
  }
  .cartaz-legenda {
    font-size: 14px;
    color: var(--bordo-claro);
  }
  .cartaz-centro {
    grid-area: centro;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-top: 6px;
  }
  .cartaz-hora {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(88px, 8.4vw, 120px);
    line-height: 0.85;
  }
  .contagem-partes {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .mosaicos {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mosaicos[hidden] {
    display: none;
  }
  .mosaicos li {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 78px;
    padding: 10px 8px;
    border-radius: var(--raio-botao);
    background: rgb(0 0 0 / 0.18);
  }
  .mosaico-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    line-height: 1;
  }
  .mosaico-legenda {
    font-size: 12px;
    color: var(--bordo-claro);
  }
  .cartaz-sub {
    font-size: 13px;
    color: var(--bordo-claro);
  }
  .cartaz-acoes {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }
  .cartaz-acoes :global(.botao) {
    min-height: 50px;
    padding-inline: 22px;
    border-radius: var(--raio-linha);
  }

  @media (min-width: 1024px) {
    .destaque {
      border-radius: 0;
    }
  }
</style>

---
// Cartão "Jogo em destaque": fundo bordô, as duas equipas, a hora, a contagem e
// "Jogadores a seguir" (2 cromos de cada equipa: os jogadores nunca representam a equipa sozinhos).
// Uma só marcação: o cartaz do computador; abaixo de 1024px muda só a disposição (media queries).
//
// Sem `jogo` (antes do sorteio): "Jogo de abertura", emblemas neutros "?", contagem para
// torneio.inicio, cromos em silhueta, .ics do torneio inteiro e "Ver o regulamento ›". Nenhum dado inventado.
import Botao from './Botao.astro';
import Cromo from './Cromo.astro';
import EmblemaEquipa from './EmblemaEquipa.astro';
import type { Equipa, Jogador, Jogo } from '../data/fonte';
import { torneio } from '../data/torneio';
import { dataLonga, horaLisboa, partesContagem } from '../scripts/datas';
import { agora as agoraSite } from '../scripts/agora';

interface Props {
  jogo?: Jogo;
  casa?: Equipa;
  fora?: Equipa;
  /** 2 jogadores de cada equipa. */
  jogadoresCasa?: Jogador[];
  jogadoresFora?: Jogador[];
  rotulo?: string;
  /** Destino de "Ver os dois plantéis". */
  hrefEquipas?: string;
}

const { jogo, casa, fora, jogadoresCasa = [], jogadoresFora = [] } = Astro.props;
const porSortear = !jogo || !casa || !fora;

const inicio = porSortear ? torneio.inicio : jogo.inicio;
const diaNum = Number(torneio.dias[0].slice(8, 10));
const rotulo = Astro.props.rotulo ?? (porSortear ? 'Jogo de abertura' : 'Jogo em destaque');
const etiqueta = porSortear ? `${diaNum} de dezembro` : jogo.grupo ? `Grupo ${jogo.grupo}` : jogo.fase;
// No lugar da hora: a hora do jogo ou, antes do sorteio, a data.
const hora = porSortear ? `${diaNum} dez` : horaLisboa(jogo.inicio);
const titulo = porSortear ? `${rotulo}, ${etiqueta}` : `${casa.nome} × ${fora.nome}`;
const nota = porSortear ? 'As equipas e os horários são conhecidos depois do sorteio.' : undefined;

// Texto do build; o script atualiza no browser.
const agora = agoraSite();
const diaLongo = dataLonga(inicio, agora);
const partes = partesContagem(inicio, agora);

const ics = porSortear
  ? {
      'data-ics': '',
      'data-ics-uid': `torneio-${torneio.dias[0].slice(0, 4)}`,
      'data-ics-dias': torneio.dias.join(','),
      'data-ics-titulo': torneio.nome,
      'data-ics-ficheiro': `abilio-pinto-futsal-cup-${torneio.dias[0].slice(0, 4)}.ics`,
    }
  : {
      'data-ics': '',
      'data-ics-uid': `${jogo.id}-${jogo.inicio.slice(0, 10)}`,
      'data-ics-inicio': jogo.inicio,
      'data-ics-titulo': `${titulo} · ${torneio.nome}`,
      'data-ics-ficheiro': `${casa.id}-${fora.id}.ics`,
    };
const acao = porSortear
  ? { texto: 'Ver o regulamento', href: torneio.links.regulamento }
  : { texto: 'Ver os dois plantéis', href: Astro.props.hrefEquipas ?? `/jogos#${jogo.id}` };

type LadoCartaz = { nome?: string; sigla: string; cor?: string; jogadores: Jogador[] };
const lados: LadoCartaz[] = porSortear
  ? [
      { sigla: '?', jogadores: [] },
      { sigla: '?', jogadores: [] },
    ]
  : [
      { nome: casa.nome, sigla: casa.sigla, cor: casa.cor, jogadores: jogadoresCasa.slice(0, 2) },
      { nome: fora.nome, sigla: fora.sigla, cor: fora.cor, jogadores: jogadoresFora.slice(0, 2) },
    ];
// Telemóvel: com nomes curtos, a hora fica entre as equipas; com nomes longos, passa para cima.
const nomesLongos = lados.some((l) => (l.nome ?? 'Por sortear').length > 9) || hora.length > 5;
---

<section
  class:list={['destaque', { 'por-sortear': porSortear, 'nomes-longos': nomesLongos }]}
  aria-label={`${rotulo}: ${porSortear ? etiqueta : titulo}`}
>
  <div class="cartaz">
    <div class="cartaz-conteudo">
      <div class="cartaz-topo">
        <p class="cartaz-rotulo"><span data-rotulo-destaque>{rotulo}</span> · {etiqueta}</p>
        <p class="cartaz-data">
          <span data-quando="dia-longo" data-inicio={inicio}>{diaLongo}</span> · {torneio.local}
        </p>
      </div>
      <div class="cartaz-grelha">
        {
          lados.map((l, i) => (
            <div class:list={['cartaz-lado', i === 0 ? 'esquerda' : 'direita']}>
              <div class="cartaz-equipa">
                <EmblemaEquipa sigla={l.sigla} cor={l.cor} neutro={!l.cor} tamanho={96} />
                <p class:list={['cartaz-nome', { vago: !l.nome }]}>{l.nome ?? 'Por sortear'}</p>
              </div>
              <div class="par">
                {l.jogadores.length > 0
                  ? l.jogadores.map((j) => (
                      <Cromo
                        nome={j.nome}
                        numero={j.numero}
                        subtitulo={j.posicao}
                        cor={l.cor!}
                        largura={72}
                        larguraComputador={132}
                      />
                    ))
                  : [0, 1].map(() => <Cromo vazio largura={72} larguraComputador={132} />)}
              </div>
              <p class="cartaz-legenda">
                <span class="leg-pc">Jogadores a seguir</span>
                <span class="leg-movel">{l.nome ?? 'Por sortear'}</span>
              </p>
            </div>
          ))
        }
        <p class="cartaz-seguir" aria-hidden="true">Jogadores a seguir</p>
        <div class="cartaz-centro">
          <p class="cartaz-hora"><span class="visually-hidden">{porSortear ? 'Começa a ' : `${titulo}, às `}</span>{hora}</p>
          <div class="contagem-partes" data-quando="partes" data-inicio={inicio}>
            <ul class="mosaicos" data-mosaicos hidden={partes.estado !== 'antes'} aria-label="Tempo até ao apito inicial">
              {
                (
                  [
                    ['dias', 'dias'],
                    ['horas', 'horas'],
                    ['minutos', 'min'],
                  ] as const
                ).map(([k, legenda]) => (
                  <li>
                    <span class="mosaico-num" data-parte={k}>
                      {partes.estado === 'antes' ? String(partes[k]).padStart(k === 'dias' ? 1 : 2, '0') : ''}
                    </span>
                    <span class="mosaico-legenda">{legenda}</span>
                  </li>
                ))
              }
            </ul>
            <p class="cartaz-sub" data-legenda>
              {partes.estado === 'antes' ? 'para o apito inicial' : partes.estado === 'decorrer' ? 'A decorrer' : 'Jogo terminado'}
            </p>
          </div>
          {nota && <p class="cartaz-nota">{nota}</p>}
          <div class="cartaz-acoes">
            <Botao variante="branco" icone="calendario" {...ics}>Adicionar ao calendário</Botao>
            <Botao variante="claro" href={acao.href}>{acao.texto}</Botao>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { atualizarQuando } from '../scripts/datas';
  import { ligarBotoesCalendario } from '../scripts/calendario';

  ligarBotoesCalendario();
  atualizarQuando();
  setInterval(() => atualizarQuando(), 30_000);
</script>

<style>
  .destaque {
    background: var(--bordo);
    color: var(--branco);
  }
  /* Antes do sorteio */
  .vago {
    color: var(--bordo-claro);
  }
  .por-sortear .cartaz-hora {
    text-transform: uppercase;
  }
  .por-sortear .cartaz-nome.vago {
    font-size: 28px;
  }
  .cartaz-nota {
    max-width: 30ch;
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    text-align: center;
    color: var(--bordo-claro);
  }

  /* Computador: cartaz em largura total, por baixo da navegação flutuante */
  .cartaz {
    margin-top: -76px; /* sobe para trás da navegação sticky (16px + 60px) */
    padding: 124px 0 48px;
  }
  .cartaz-conteudo {
    max-width: calc(var(--max-largo) + 2 * var(--margem-largo));
    margin: 0 auto;
    padding-inline: var(--margem-largo);
  }
  .cartaz p {
    margin: 0;
  }
  .cartaz-topo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
  }
  .cartaz-rotulo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    text-transform: uppercase;
  }
  .cartaz-data {
    font-size: 15px;
    color: var(--bordo-claro);
  }
  .cartaz-grelha {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-areas: 'esq centro dir';
    align-items: start;
    gap: 32px;
    margin-top: 32px;
  }
  .cartaz-lado {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  .esquerda {
    grid-area: esq;
    align-items: flex-start;
  }
  .direita {
    grid-area: dir;
    align-items: flex-end;
  }
  .cartaz-equipa {
    display: flex;
    align-items: center;
    gap: 18px;
    min-width: 0;
  }
  .direita .cartaz-equipa {
    flex-direction: row-reverse;
    text-align: right;
  }
  .cartaz-nome {
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 5vw, 72px);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .par {
    display: flex;
    gap: 14px;
  }
  .cartaz-legenda {
    font-size: 14px;
    color: var(--bordo-claro);
  }
  .leg-movel,
  .cartaz-seguir {
    display: none;
  }
  .cartaz-centro {
    grid-area: centro;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-top: 6px;
  }
  .cartaz-hora {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(88px, 8.4vw, 120px);
    line-height: 0.85;
  }
  .contagem-partes {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .mosaicos {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mosaicos[hidden] {
    display: none;
  }
  .mosaicos li {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 78px;
    padding: 10px 8px;
    border-radius: var(--raio-botao);
    background: rgb(0 0 0 / 0.18);
  }
  .mosaico-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    line-height: 1;
  }
  .mosaico-legenda {
    font-size: 12px;
    color: var(--bordo-claro);
  }
  .cartaz-sub {
    font-size: 13px;
    color: var(--bordo-claro);
  }
  .cartaz-acoes {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }
  .cartaz-acoes :global(.botao) {
    min-height: 50px;
    padding-inline: 22px;
    border-radius: var(--raio-linha);
  }

  /* Telemóvel e tablet: a mesma marcação numa coluna. A faixa começa no topo
     (o cabeçalho da navegação fica por cima, sobre o bordô: ver NavFlutuante sobreDestaque). */
  @media (max-width: 1023.98px) {
    .cartaz {
      margin-top: 0;
      padding: 14px 0 24px;
    }
    .cartaz-conteudo {
      padding-inline: 20px;
    }
    .cartaz-topo {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding-bottom: 12px;
    }
    .cartaz-rotulo {
      font-size: 18px;
      line-height: 1.1;
    }
    .cartaz-data {
      font-size: 13px;
    }
    /* Os blocos do computador desfazem-se e as peças arrumam-se numa grelha de 2 colunas. */
    .cartaz-grelha {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'equipas equipas'
        'mosaicos mosaicos'
        'seguir seguir'
        'par-casa par-fora'
        'leg-casa leg-fora'
        'nota nota'
        'acoes acoes';
      align-items: center;
      gap: 0;
      margin-top: 18px;
    }
    .nomes-longos .cartaz-grelha {
      grid-template-areas:
        'hora hora'
        'casa fora'
        'mosaicos mosaicos'
        'seguir seguir'
        'par-casa par-fora'
        'leg-casa leg-fora'
        'nota nota'
        'acoes acoes';
    }
    .cartaz-lado,
    .cartaz-centro {
      display: contents;
    }
    /* Nomes curtos: casa, hora e fora na mesma linha (a hora sobrepõe-se ao centro da linha). */
    .esquerda .cartaz-equipa {
      grid-area: equipas;
      justify-self: start;
    }
    .direita .cartaz-equipa {
      grid-area: equipas;
      justify-self: end;
    }
    .cartaz-hora {
      grid-area: equipas;
      justify-self: center;
      font-size: clamp(52px, 16vw, 64px);
    }
    .nomes-longos .esquerda .cartaz-equipa {
      grid-area: casa;
    }
    .nomes-longos .direita .cartaz-equipa {
      grid-area: fora;
    }
    .nomes-longos .cartaz-hora {
      grid-area: hora;
      margin-bottom: 14px;
    }
    .cartaz-equipa,
    .direita .cartaz-equipa {
      flex-direction: column;
      gap: 8px;
      max-width: 110px;
      text-align: center;
    }
    .nomes-longos .cartaz-equipa {
      max-width: none;
    }
    .cartaz-equipa :global(.emblema) {
      --tamanho: 52px !important;
    }
    .cartaz-nome {
      font-size: 24px;
      line-height: 0.95;
      overflow-wrap: anywhere;
    }
    .por-sortear .cartaz-nome.vago {
      font-size: 18px;
    }
    .contagem-partes {
      grid-area: mosaicos;
      margin-top: 18px;
    }
    .mosaicos li {
      min-width: 72px;
      padding: 8px;
    }
    .mosaico-num {
      font-size: 34px;
    }
    .cartaz-seguir {
      display: block;
      grid-area: seguir;
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid rgb(255 255 255 / 0.2);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--dourado-claro);
    }
    .par {
      justify-content: center;
      gap: 8px;
      padding-top: 10px;
    }
    .esquerda .par {
      grid-area: par-casa;
      padding-right: 8px;
    }
    .direita .par {
      grid-area: par-fora;
      padding-left: 8px;
      border-left: 1px solid rgb(255 255 255 / 0.2);
    }
    .cartaz-legenda {
      padding-top: 8px;
      font-size: 12px;
      text-align: center;
    }
    .esquerda .cartaz-legenda {
      grid-area: leg-casa;
    }
    .direita .cartaz-legenda {
      grid-area: leg-fora;
      border-left: 1px solid rgb(255 255 255 / 0.2);
    }
    .leg-pc {
      display: none;
    }
    .leg-movel {
      display: inline;
    }
    .cartaz-nota {
      grid-area: nota;
      max-width: none;
      margin-top: 16px;
      font-size: 14px;
    }
    .cartaz-acoes {
      grid-area: acoes;
      margin-top: 18px;
    }
    .cartaz-acoes :global(.botao) {
      width: 100%;
      min-height: 48px;
    }
  }
</style>

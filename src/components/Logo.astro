---
// Logótipo de texto. Duas linhas no telemóvel, uma só no computador.
// Não é um link: o texto simples nunca é clicável (o Início está na navegação).
interface Props {
  /** 'auto' (2 linhas no telemóvel, 1 no computador), ou forçar. */
  linhas?: 'auto' | 1 | 2;
  tamanho?: number;
  /** Para fundos escuros: "Abílio Pinto" a branco e "Futsal Cup" em bordô-claro. */
  claro?: boolean;
}
const { linhas = 'auto', tamanho = 21, claro = false } = Astro.props;
---

<p class:list={['logo', `linhas-${linhas}`, { claro }]} style={`--tamanho: ${tamanho}px`}>
  <span>Abílio Pinto</span> <span class="cup">Futsal Cup</span>
</p>

<style>
  .logo {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--tamanho);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--texto);
  }
  .cup {
    color: var(--destaque);
  }
  .claro {
    color: var(--branco);
  }
  .claro .cup {
    color: var(--bordo-claro);
  }
  .linhas-2 span,
  .linhas-auto span {
    display: block;
  }
  .linhas-1 {
    white-space: nowrap;
  }
  @media (min-width: 1024px) {
    .linhas-auto {
      white-space: nowrap;
    }
    .linhas-auto span {
      display: inline;
    }
  }
</style>

---
// Linha de jogo: cartão branco com contorno que se carrega inteiro.
// Com `emblemaCasa`/`emblemaFora` mostra emblemas pequenos (26px) antes dos nomes.
// Com `etiqueta` (grupo ou fase) usa a grelha de colunas fixas da secção "Jogos" do computador:
// hora | casa (à direita, nome + emblema) | × | fora (à esquerda, emblema + nome) | etiqueta | ›
// para os nomes ficarem alinhados de linha para linha.
// Com `resultado`, o "×" dá lugar ao resultado; com estado 'a-decorrer', aparece "A decorrer".
import EmblemaEquipa from './EmblemaEquipa.astro';
import Icone from './Icone.astro';

interface Emblema {
  sigla: string;
  cor: string;
}

interface Props {
  hora: string;
  casa: string;
  fora: string;
  href: string;
  emblemaCasa?: Emblema;
  emblemaFora?: Emblema;
  /** Grupo ou fase ("Grupo C", "Quartos"). Ativa a grelha de colunas fixas. */
  etiqueta?: string;
  /** Realça o jogo (o jogo em destaque). */
  destaque?: boolean;
  /** Golos [casa, fora]: final se terminado, parcial se a decorrer. */
  resultado?: [number, number];
  estado?: 'por-jogar' | 'a-decorrer' | 'terminado';
}
const { hora, casa, fora, href, emblemaCasa, emblemaFora, etiqueta, destaque = false, resultado, estado = 'por-jogar' } =
  Astro.props;
const placar = resultado ? `${resultado[0]}–${resultado[1]}` : undefined;
const rotulo =
  estado === 'terminado' && placar
    ? `Ver o jogo ${casa} ${placar} ${fora}, terminado`
    : estado === 'a-decorrer'
      ? `Ver o jogo ${casa} contra ${fora}, a decorrer${placar ? `, ${placar}` : ''}`
      : `Ver o jogo ${casa} contra ${fora}, às ${hora}`;
---

{
  etiqueta !== undefined ? (
    <a class:list={['grelha', estado, { destaque }]} href={href} aria-label={rotulo}>
      <span class="g-hora">{hora}</span>
      <span class="g-casa">
        <span class="g-nome">{casa}</span>
        {emblemaCasa && <EmblemaEquipa sigla={emblemaCasa.sigla} cor={emblemaCasa.cor} tamanho={32} anel={0} />}
      </span>
      <span class:list={['g-x', { placar: !!placar }]} aria-hidden="true">{placar ?? '×'}</span>
      <span class="g-fora">
        {emblemaFora && <EmblemaEquipa sigla={emblemaFora.sigla} cor={emblemaFora.cor} tamanho={32} anel={0} />}
        <span class="g-nome">{fora}</span>
      </span>
      <span class:list={['g-etiqueta', { 'ao-vivo': estado === 'a-decorrer' }]}>
        {estado === 'a-decorrer' ? 'A decorrer' : etiqueta}
      </span>
      <span class="g-seta"><span class="g-ver">Ver jogo</span><Icone nome="seta" tamanho={18} /></span>
    </a>
  ) : (

<a class:list={['linha-jogo', estado, { destaque }]} href={href} aria-label={rotulo}>
  <span class="hora">{hora}</span>
  <span class="equipas">
    {emblemaCasa && <EmblemaEquipa sigla={emblemaCasa.sigla} cor={emblemaCasa.cor} tamanho={26} anel={0} />}
    <span class="nome">{casa}</span>
    <span class:list={['x', { placar: !!placar }]}>{placar ?? '×'}</span>
    {emblemaFora && <EmblemaEquipa sigla={emblemaFora.sigla} cor={emblemaFora.cor} tamanho={26} anel={0} />}
    <span class="nome">{fora}</span>
  </span>
  <span class:list={['ver', { 'ao-vivo': estado === 'a-decorrer' }]}>
    {estado === 'a-decorrer' ? 'A decorrer' : 'Ver jogo'}<Icone nome="seta" tamanho={16} />
  </span>
</a>
  )
}

<style>
  /* Grelha de colunas fixas (secção "Jogos" do computador).
     A 3.ª coluna tem 40px para caber o resultado ("10–2"). */
  .grelha {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 40px minmax(0, 1fr) 72px 24px;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 0 18px 0 20px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-linha);
    background: var(--branco);
    color: var(--texto);
    text-decoration: none;
  }
  .grelha:hover {
    border-color: var(--bordo);
  }
  .g-hora {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    text-align: left;
  }
  .g-casa,
  .g-fora {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .g-casa {
    justify-content: flex-end;
  }
  .g-fora {
    justify-content: flex-start;
  }
  .g-nome {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 16px;
    font-weight: 600;
  }
  .destaque .g-nome {
    font-weight: 800;
  }
  .g-x {
    text-align: center;
    color: var(--texto-2);
  }
  .g-etiqueta {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 12px;
    text-align: right;
    color: var(--texto-2);
  }
  .g-seta {
    display: flex;
    justify-content: flex-end;
    color: var(--bordo);
  }
  /* Texto "Ver jogo" escondido por omissão (o Início no telemóvel mostra-o). */
  .g-ver {
    display: none;
  }

  /* Resultado e estado */
  .placar {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 19px;
    color: var(--texto);
    white-space: nowrap;
  }
  .terminado .g-hora,
  .terminado .hora {
    color: var(--texto-2);
  }
  .ao-vivo {
    font-weight: 700;
    color: var(--bordo);
  }
  .a-decorrer {
    border-color: var(--bordo);
  }

  /* Grelha no telemóvel: sem emblemas nem etiqueta, para os nomes caberem. */
  @media (max-width: 1023.98px) {
    .grelha {
      grid-template-columns: 46px minmax(0, 1fr) 32px minmax(0, 1fr) 18px;
      gap: 8px;
      min-height: 56px;
      padding: 0 10px 0 14px;
    }
    .g-hora {
      font-size: 19px;
    }
    .grelha :global(.emblema),
    .g-etiqueta {
      display: none;
    }
    .g-nome {
      font-size: 15px;
    }
    /* Sem a coluna da etiqueta, o jogo a decorrer distingue-se pela hora a bordô. */
    .a-decorrer .g-hora {
      color: var(--bordo);
    }
  }

  /* Linha simples */
  .linha-jogo {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 0 12px 0 16px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-linha);
    background: var(--branco);
    color: var(--texto);
    text-decoration: none;
  }
  .linha-jogo:hover {
    border-color: var(--bordo);
  }
  .hora {
    min-width: 50px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 19px;
  }
  .equipas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
    min-width: 0;
    font-size: 16px;
    font-weight: 500;
  }
  .destaque .equipas {
    font-weight: 700;
  }
  .x {
    color: var(--texto-2);
    font-weight: 400;
  }
  .ver {
    display: inline-flex;
    align-items: center;
    gap: 14px; /* igual à versão anterior no telemóvel */
    font-size: 12px;
    font-weight: 700;
    color: var(--bordo);
    white-space: nowrap;
  }
  @media (min-width: 1024px) {
    .linha-jogo {
      grid-template-columns: 60px minmax(0, 1fr) auto;
      min-height: 64px;
      padding: 0 14px 0 18px;
    }
    .hora {
      min-width: 0;
      font-size: 22px;
    }
    .equipas {
      gap: 4px 10px;
      font-weight: 600;
    }
    .destaque .equipas {
      font-weight: 800;
    }
    .ver {
      gap: 2px;
      font-size: 13px;
    }
  }
</style>

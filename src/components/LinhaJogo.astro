---
// Linha de jogo: cartão branco com contorno que se carrega inteiro.
import Icone from './Icone.astro';

interface Props {
  hora: string;
  casa: string;
  fora: string;
  href: string;
  /** Realça o jogo (por exemplo, o jogo em destaque). */
  destaque?: boolean;
}
const { hora, casa, fora, href, destaque = false } = Astro.props;
---

<a class:list={['linha-jogo', { destaque }]} href={href} aria-label={`Ver o jogo ${casa} contra ${fora}, às ${hora}`}>
  <span class="hora">{hora}</span>
  <span class="equipas">{casa} <span class="x">×</span> {fora}</span>
  <span class="ver">Ver jogo</span>
  <Icone nome="seta" tamanho={16} />
</a>

<style>
  .linha-jogo {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 0 12px 0 16px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-linha);
    background: var(--branco);
    color: var(--texto);
    text-decoration: none;
  }
  .linha-jogo:hover {
    border-color: var(--bordo);
  }
  .linha-jogo :global(svg) {
    color: var(--bordo);
  }
  .hora {
    min-width: 50px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 19px;
  }
  .equipas {
    flex: 1;
    min-width: 0;
    font-size: 16px;
    font-weight: 500;
  }
  .destaque .equipas {
    font-weight: 700;
  }
  .x {
    color: var(--texto-2);
    font-weight: 400;
  }
  .ver {
    font-size: 12px;
    font-weight: 700;
    color: var(--bordo);
    white-space: nowrap;
  }
  @media (min-width: 1024px) {
    .hora {
      font-size: 20px;
    }
  }
</style>

---
// Barra "Quem apoia": fila em movimento contínuo (conteúdo duplicado; a cópia tem aria-hidden).
// Para com o rato por cima ou com foco, e fica parada com prefers-reduced-motion.
// Os patrocinadores de torneio.patrocinadores ocupam os espaços pela ordem; os que sobram são
// links "O seu logótipo aqui ›" para a página /patrocinar (telemóvel e computador).
import Icone from './Icone.astro';
import { torneio } from '../data/torneio';

interface Props {
  /** Destino dos espaços vazios no computador. */
  hrefVaga?: string;
}
const { hrefVaga = torneio.links.patamares } = Astro.props;
const patrocinadores = torneio.patrocinadores.slice(0, torneio.espacosPatrocinio);
const vagas = Array.from({ length: Math.max(0, torneio.espacosPatrocinio - patrocinadores.length) });
---

<section class="patrocinadores" aria-label="Patrocinadores">
  <div class="conteudo">
    <p class="rotulo so-computador">Quem<br />apoia</p>
    <div class="marquee">
      <div class="pista">
        {
          [false, true].map((copia) => (
            <ul class="grupo" aria-hidden={copia ? 'true' : undefined}>
              <li class="principal">
                <span class="principal-nome">
                  {torneio.patrocinadorPrincipal}
                  {!copia && <span class="visually-hidden"> (patrocinador principal)</span>}
                </span>
              </li>
              {patrocinadores.map((p) => (
                <li class="logo">
                  <img src={p.logo} alt={copia ? '' : p.nome} loading="lazy" decoding="async" />
                </li>
              ))}
              {vagas.map(() => (
                <li class="espaco">
                  <a class="vaga-link" href={hrefVaga} tabindex={copia ? -1 : undefined}>
                    O seu logótipo aqui
                    <Icone nome="seta" tamanho={14} />
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .patrocinadores {
    margin-top: 16px;
  }
  .conteudo {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .marquee {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .pista {
    display: flex;
    width: max-content;
    animation: deslizar 38s linear infinite;
  }
  .marquee:hover .pista,
  .marquee:focus-within .pista {
    animation-play-state: paused;
  }
  @keyframes deslizar {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pista {
      animation: none;
    }
    .marquee {
      overflow-x: auto;
    }
  }

  .grupo {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0 10px 0 0;
    list-style: none;
  }
  .principal,
  .logo,
  .vaga-link {
    flex: none;
    display: flex;
    align-items: center;
    height: var(--toque); /* 44px: os espaços vazios são links */
    border-radius: 10px;
  }
  .espaco {
    display: flex;
  }
  .principal {
    gap: 10px;
    padding: 0 16px;
    background: var(--azul-ap);
    color: var(--branco);
  }
  .principal-nome {
    /* Marcador até chegar o logótipo oficial. */
    font-family: var(--font-marcador);
    font-style: italic;
    font-weight: 800;
    font-size: 16px;
    white-space: nowrap;
  }
  .logo {
    justify-content: center;
    width: 112px;
    padding: 4px 10px;
    border: 1px solid var(--linha);
    background: var(--branco);
  }
  .logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .vaga-link {
    justify-content: center;
    gap: 2px;
    min-width: 150px;
    min-height: var(--toque);
    padding: 0 12px;
    border: 1.5px dashed var(--linha);
    background: var(--branco);
    color: var(--bordo);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .vaga-link:hover {
    border-color: var(--bordo);
    border-style: solid;
  }

  .rotulo {
    flex: none;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    line-height: 1;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .patrocinadores {
      margin-top: 0;
      border-bottom: 1px solid var(--linha);
    }
    .conteudo {
      max-width: calc(var(--max-largo) + 2 * var(--margem-largo));
      margin: 0 auto;
      padding: 20px var(--margem-largo);
    }
    .marquee {
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    }
    .grupo {
      gap: 16px;
      padding-right: 16px;
    }
    .principal,
    .logo,
    .vaga-link {
      height: 60px;
      border-radius: 14px;
    }
    .principal {
      padding: 0 26px;
    }
    .principal-nome {
      font-size: 22px;
    }
    .logo {
      width: 190px;
      padding: 8px 16px;
    }
    .vaga-link {
      gap: 4px;
      width: 190px;
      font-size: 13px;
    }
  }
</style>

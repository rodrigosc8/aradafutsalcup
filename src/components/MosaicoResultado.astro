---
// Mosaico de resultado: cartão com contorno, resultado (ou hora) em Barlow, adversário e "Ver jogo ›".
import Icone from './Icone.astro';

interface Props {
  /** "3–1", ou a hora de um jogo por jogar ("20:10"). */
  resultado: string;
  adversario: string;
  href: string;
  /** Texto por baixo, em vez de "vs Adversário" (ex.: "hoje"). */
  legenda?: string;
}
const { resultado, adversario, href, legenda } = Astro.props;
---

<a class="mosaico" href={href} aria-label={`Ver o jogo contra ${adversario}: ${resultado}`}>
  <span class="resultado">{resultado}</span>
  <span class="adversario">{legenda ?? `vs ${adversario}`}</span>
  <span class="ver">Ver jogo<Icone nome="seta" tamanho={12} /></span>
</a>

<style>
  .mosaico {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-height: var(--toque);
    padding: 10px 6px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-botao);
    background: var(--branco);
    color: var(--texto);
    text-decoration: none;
    text-align: center;
  }
  .mosaico:hover {
    border-color: var(--bordo);
  }
  .resultado {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 23px;
    line-height: 1.1;
  }
  .adversario {
    font-size: 12px;
    color: var(--texto-2);
  }
  .ver {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-top: 2px;
    font-size: 11px;
    font-weight: 700;
    color: var(--bordo);
  }
</style>

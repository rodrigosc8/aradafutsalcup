---
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '../styles/global.css';
import { torneio } from '../data/torneio';

interface Props {
  title?: string;
  description?: string;
  /** Páginas internas (ex.: /componentes) que não devem aparecer nos motores de pesquisa. */
  noindex?: boolean;
}

const {
  title = `${torneio.nome} · ${torneio.subtitulo}`,
  description = `${torneio.edicao} do ${torneio.subtitulo}: ${torneio.diasTexto}, no ${torneio.local}.`,
  noindex: noindexPagina = false,
} = Astro.props;
// No modo de revisão, nenhuma página é indexada (e o robots.txt bloqueia tudo: ver astro.config.mjs).
const noindex = noindexPagina || torneio.modoRevisao;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#7a1e2c" />

    {/* Partilha nas redes (Open Graph). A imagem entra quando houver logótipo. */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <slot />
  </body>
</html>
